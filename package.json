{
  "name": "F_TNDR_CAG_FAST_CCMA_BACKEND",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^8",
    "express": "^4",
    "@sap/xssec": "^4",
    "@cap-js/hana": "^1"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.9.0",
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "@types/node": "^22.0.0",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "before:cds-watch": "cds-typer \"*\"",
    "watch": "cds-tsx w",
    "watch:ts:mv": "cds bind --exec npm run watch:ts --profile mandar",
    "deploy:hana:mv": "cds bind --exec cds deploy --to hana --profile mandar"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "auth": "xsuaa",
      "html5-runtime": true
    },
    "sql": {
      "native_hana_associations": false
    }
  }
}
