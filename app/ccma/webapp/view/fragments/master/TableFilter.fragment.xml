	<u:Menu>
		<u:MenuItem id="sortAscID" text="Sort Ascending" select="handleMenuItemAsPress" icon="sap-icon://sort-ascending"/>
		<u:MenuItem id="sortDescID" text="Sort Descending" select="handleMenuDesItemPress" icon="sap-icon://sort-descending"/>
