<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:up="sap.uxap"
    xmlns:form="sap.ui.layout.form"
    xmlns:u="sap.uxap"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tree="sap.ui.table"
>
    <Panel
        expandable="true"
        expanded="true"
        headerText="{i18n>ProductsListFragment.ProducstList}"
    >
        <Table
            id="idCCMContract"
            inset="false"
            items="{
                path: '/CCMContractView',
                parameters: { select: '*' }
            }"
            class="sapFDynamicPageAlignContent"
            width="auto"
            updateFinished=".onUpdateFinished"
            alternateRowColors="true"
            contextualWidth="Auto"
            growing="true"
            growingThreshold="15"
            growingScrollToLoad="false"
        >
            <columns>
                <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.Product}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column>
                  <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.ActualSKU}"
                            titleActive="true"
                        />
                    </header>
                </Column>
                  <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.PreviousSKU}"
                            titleActive="true"
                        />
                    </header>
                </Column>
                <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.StartDate}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column>
                <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.EndDate}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column>
                <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.SAPInvoicePrice}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column>
                <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.SAPRappel}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column>
                <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.INTERACTFOC}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column>
                <!-- <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.MaterialNumbers}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column> -->
                <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.NewMaterialNumber}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column>
                <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.SAPContractNumber}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column>
                <Column>
                    <header>
                        <ObjectIdentifier
                            title="{i18n>ProductsListFragment.PrevSAPContractNumber}"
                            titleActive="true"
                            titlePress="onClick"
                        />
                    </header>
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    type="Navigation"
                    press=".onListItemPress"
                    id="productItems"
                >
                    <cells>
                        <Text text="{ProductName}" />
                        <Text text="{ path: 'ContractMaterialNumbers', formatter: '.formatter.formatActiveMaterials' }" />
                        <Text text="{path: 'ContractMaterialNumbers', formatter: '.formatter.formatInactiveMaterials'}" />
                        <Text
                            text="{
									path: 'CCMContractStartDate',
									type: 'sap.ui.model.odata.type.Date',
									formatOptions: {
										pattern: 'yyyy-MM-dd'
									}
									}"
                        />
                        <Text
                            text="{
									path: 'CCMContractEndDate',
									type: 'sap.ui.model.odata.type.Date',
									formatOptions: {
										pattern: 'yyyy-MM-dd'
									}
									}"
                        />
                        <Text text="{OfferPrice}" />
                        <Text text="{hasRappel}" />
                        <Text text="{hasFOC}" />
                        <!-- <Text text="{ContractMaterialNumbers}" /> -->
                        <Text text="{NewMaterialNumber}" />
                        <Text text="{ContractNumber}" />
                        <Text text="{PreviousContractNumber}" />
                        <Text text="{InstituteName}" visible="false"/>
                        <Text text="{InstituteType}" visible="false"/>
                        <Text text="{ProductCode}" visible="false"/>
                        <Text text="{FastConditionContractsID}" visible="false"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Panel>
</core:FragmentDefinition>
