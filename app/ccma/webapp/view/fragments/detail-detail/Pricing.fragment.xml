<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:up="sap.uxap" 
	xmlns:form="sap.ui.layout.form" 
	xmlns:u="sap.uxap"
	xmlns:t="sap.ui.table" 
	xmlns:l="sap.ui.layout"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tree="sap.ui.table">

    <Panel
        expandable="true"
        expanded="true"
        headerText="{i18n>PricingFragment.Pricing}"
    >   
        <tree:Table 
			selectionMode="Single"
			rowActionCount="1"
		>
			<!-- <tree:rowActionTemplate> 
				<tree:RowAction> 
					<tree:RowActionItem type="Navigation" press=".onListItemPress" /> 
				</tree:RowAction> 
			</tree:rowActionTemplate> -->
			<tree:columns>
				<tree:Column sortProperty="InvoicePrice" filterProperty="InvoicePrice">
					<Label text="{i18n>PricingFragment.InvoicePrice}" />
					<tree:template>
						<Text text="" />
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="Rappel" filterProperty="Rappel">
					<Label text="{i18n>PricingFragment.Rappel}" />
					<tree:template>
						<Text text=""/>
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="FOC" filterProperty="FOC">
					<Label text="{i18n>PricingFragment.FOC}" />
					<tree:template>
						<Text text=""/>
					</tree:template>
				</tree:Column>
			</tree:columns>
		</tree:Table>
    </Panel>

</core:FragmentDefinition>