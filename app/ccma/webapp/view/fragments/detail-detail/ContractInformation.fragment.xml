<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:up="sap.uxap" 
	xmlns:form="sap.ui.layout.form" 
	xmlns:u="sap.uxap"
	xmlns:t="sap.ui.table" 
	xmlns:l="sap.ui.layout"
	xmlns:mvc="sap.ui.core.mvc">

    <Panel
        expandable="true"
        expanded="true"
        headerText="{i18n>ContractInformationFragment.ContractInformation}"
    >   
    <form:Form
		    id="idDetailDetailContractInformation"
		    editable="true"       
	    >
		<form:toolbar>
			<Toolbar>
				<ToolbarSpacer />
				<Button
					id="idContractInformationPopOver"
					icon="sap-icon://alert"
					visible="false"
					type="Emphasized"
					press="onMessagePopoverPress($event)"  
				/>
				<Button
					icon="sap-icon://edit"
					text="Edit"
					press=".onContractInformationFormEditBtnPress"
					visible="{= !${ui>/ContractInformationForm/editMode} }"
				/>
				<Button
					icon="sap-icon://save"
					text="Save"
					press=".onContractInformationFormSaveBtnPress"
					visible="{= ${ui>/ContractInformationForm/editMode} }"
				/>
				<Button
					icon="sap-icon://decline"
					text="Cancel"
					press=".onContractInformationFormCancelBtnPress"
					visible="{= ${ui>/ContractInformationForm/editMode} }"
				/>
			</Toolbar>
		</form:toolbar>
		<form:layout>
			<form:ResponsiveGridLayout
				labelSpanXL="5"
				labelSpanL="5"
				labelSpanM="5"
				labelSpanS="9"
				adjustLabelSpan="false"
				emptySpanXL="0"
				emptySpanL="0"
				emptySpanM="0"
				emptySpanS="0"
				columnsXL="3"
				columnsL="3"
				columnsM="3"
				singleContainerFullSize="false" />
		</form:layout>
		<form:formContainers>
			<form:FormContainer>
				<form:formElements>
					<form:FormElement label="{i18n>ContractInformationFragment.StartDate}">
						<form:fields>
							<DatePicker 
								enabled="{= ${ui>/ContractInformationForm/editMode}}"
								value = "{
									path: 'CCMContractStartDate',
									type: 'sap.ui.model.odata.type.Date',
									formatOptions: { 
										pattern: 'yyyy-MM-dd',
										UTC: false
									}
								}"
							/>
						</form:fields>
					</form:FormElement>

                    <form:FormElement label="{i18n>ContractInformationFragment.EndtDate}" >
						<form:fields>
							<DatePicker 
								enabled="{= ${ui>/ContractInformationForm/editMode}}"
								value = "{
									path: 'CCMContractEndDate',
									type: 'sap.ui.model.odata.type.Date',
									formatOptions: { 
										pattern: 'yyyy-MM-dd',
										UTC: false
									}
								}"
							/>
						</form:fields>
					</form:FormElement>

                    <form:FormElement label="{i18n>ContractInformationFragment.Extension}" >
						<form:fields>
							<CheckBox id="idExtendExpiry" enabled="{= ${ui>/ContractInformationForm/editMode}}" selected="{path:'Extension'}"/>
						</form:fields>
					</form:FormElement>

                    <form:FormElement label="{i18n>ContractInformationFragment.ExtensionPeriod}" >
						<form:fields>
							<StepInput
								id="idExtendExpiryDateID"
								value="{path: 'ExtensionPeriod'}"
								min="0"
								max="12"
								enabled="{= ${ui>/ContractInformationForm/editMode}}"
								description="Months" 
								validationMode="LiveChange"
							/>
						</form:fields>
					</form:FormElement>
					
				</form:formElements>
			</form:FormContainer>
		</form:formContainers>
	</form:Form>
    </Panel>

</core:FragmentDefinition>