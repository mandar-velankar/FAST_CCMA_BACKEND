<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:up="sap.uxap" 
	xmlns:form="sap.ui.layout.form" 
	xmlns:u="sap.uxap"
	xmlns:t="sap.ui.table" 
	xmlns:l="sap.ui.layout"
	xmlns:mvc="sap.ui.core.mvc">

    <Panel
        expandable="true"
        expanded="true"
        headerText="{i18n>ContractInformationFragment.ContractInformation}"
    >   
    <form:Form
		    id="idDetailDetailContractInformation"
		    editable="true"       
	    >
		<form:toolbar>
			<Toolbar>
				<ToolbarSpacer />
				<Button
					icon="sap-icon://alert"
					type="Emphasized"
					press="onMessagePopoverPress($event, 'contractInformationDetailDetail')"
					text="{= ${messages>/contractInformationDetailDetail}.length }"
					visible="{= ${messages>/contractInformationDetailDetail}.length > 0 &amp;&amp; ${ui>/ContractInformationForm/editMode}}"
				/>
				<Button
					icon="sap-icon://edit"
					text="Edit"
					press=".onContractInformationFormEditBtnPress"
					visible="{= !${ui>/ContractInformationForm/editMode} }"
				/>
				<Button
					icon="sap-icon://save"
					text="Save"
					press=".onContractInformationFormSaveBtnPress"
					visible="{= ${ui>/ContractInformationForm/editMode} }"
				/>
				<Button
					icon="sap-icon://decline"
					text="Cancel"
					press=".onContractInformationFormCancelBtnPress"
					visible="{= ${ui>/ContractInformationForm/editMode} }"
				/>
			</Toolbar>
		</form:toolbar>
		<form:layout>
			<form:ResponsiveGridLayout
				labelSpanXL="5"
				labelSpanL="5"
				labelSpanM="5"
				labelSpanS="9"
				adjustLabelSpan="false"
				emptySpanXL="0"
				emptySpanL="0"
				emptySpanM="0"
				emptySpanS="0"
				columnsXL="3"
				columnsL="3"
				columnsM="3"
				singleContainerFullSize="false" />
		</form:layout>
		<form:formContainers>
			<form:FormContainer>
				<form:formElements>
					<form:FormElement label="{i18n>ContractInformationFragment.StartDate}">
						<form:fields>
							<DatePicker 
								enabled="{= ${ui>/ContractInformationForm/editMode} &amp;&amp; !${ui>/hasExistingContract}}"
								value = "{
									path: 'CCMContractStartDate',
									type: 'sap.ui.model.odata.type.Date',
									formatOptions: { 
										pattern: 'yyyy-MM-dd',
										UTC: false
									}
								}"
								change=".onChangeContractStartDate"
								minDate="{ui>/minDate}"
							/>
						</form:fields>
					</form:FormElement>

                    <form:FormElement label="{i18n>ContractInformationFragment.EndtDate}" >
						<form:fields>
							<DatePicker 
								enabled="{= ${ui>/ContractInformationForm/editMode} &amp;&amp; !${ui>/hasExistingContract}}"
								value = "{
									path: 'CCMContractEndDate',
									type: 'sap.ui.model.odata.type.Date',
									formatOptions: { 
										pattern: 'yyyy-MM-dd',
										UTC: false
									}
								}"
								minDate="{
									path: 'CCMContractStartDate',
									formatter: '.formatMinDate'
								}"
							/>
						</form:fields>
					</form:FormElement>

                    <form:FormElement label="{i18n>ContractInformationFragment.Extension}" visible="{ui>/showExtensionFields}">
						<form:fields>
							<CheckBox enabled="{= ${ui>/ContractInformationForm/editMode} &amp;&amp; !${ui>/hasCancelled}}" selected="{path:'Extension'}"/>
						</form:fields>
					</form:FormElement>

                    <form:FormElement label="{i18n>ContractInformationFragment.ExtensionPeriod}" visible="{ui>/showExtensionFields}">
						<form:fields>
							<StepInput
								value="{path: 'ExtensionPeriod'}"
								min="0"
								max="12"
								enabled="{= ${ui>/ContractInformationForm/editMode} &amp;&amp; !${ui>/hasCancelled}}"
								description="Months" 
								validationMode="LiveChange"
							/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="ProductName" visible="false">
						<form:fields>
							<Text text="{ProductName}" visible="false"/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="ContractNumber" visible="false">
						<form:fields>
							<Text text="{ContractNumber}" visible="false"/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="ContractType" visible="false">
						<form:fields>
							<Text text="{ContractType}" visible="false"/>
						</form:fields>
					</form:FormElement>		
					<form:FormElement label="Cancelled" visible="false">
						<form:fields>
							<Text text="{Cancelled}" visible="false"/>
						</form:fields>
					</form:FormElement>	
				</form:formElements>
			</form:FormContainer>
		</form:formContainers>
	</form:Form>
    </Panel>

</core:FragmentDefinition>