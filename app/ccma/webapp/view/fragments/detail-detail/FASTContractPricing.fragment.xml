<core:FragmentDefinition
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>

        <form:Form
        id="idNewPricingForm"
        editable="true"
    >
        <form:title>
            <core:Title text="{i18n>ESPricingFragment.FASTContractPricing}" />
        </form:title>
        <form:layout>
            <form:ResponsiveGridLayout
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
            />
        </form:layout>
        <form:formContainers>
            <form:FormContainer>
                <form:formElements>
                    <form:FormElement>
                        <form:fields>
                            <m:Title text="{ConditionType}" level="H4"/>
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.PVL}"
                        visible="{= %{ConditionType} !== 'Rental'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['YP00', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{ConditionType} !== 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.ConfidentialDiscount}"
                        visible="{= %{YP04} > 0 &amp;&amp; %{ConditionType} !== 'Rental'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{path: 'YP04', 
type: 'com.bayer.tender.ccma.model.datatypes.PercentageType'}"
                                enabled="false"
                                visible="{= %{YP04} > 0 &amp;&amp; %{ConditionType} !== 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.ConfidentialPrice}"
                        visible="{= %{YP04} > 0 &amp;&amp; %{ConditionType} !== 'Rental'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['ConfidentialPrice', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{YP04} > 0 &amp;&amp; %{ConditionType} !== 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.AdditionalDiscount}"
                        visible="{= %{ConditionType} === 'PrecioNeto'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{
                                    parts: [
                                        { path: 'YD75' },
                                        { value: '3' },
                                        { value: '3' }
                                    ],
                                    type: 'com.bayer.tender.ccma.model.datatypes.PercentageType'
                                }"
                                enabled="false"
                                visible="{= %{ConditionType} === 'PrecioNeto'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.Discount}"
                        visible="{= %{ConditionType} === 'DescuentoComercial' || %{ConditionType} === 'DescuentoEspecial'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{
                                    parts: [
                                        { path: 'YD02' },
                                        { value: '3' },
                                        { value: '3' }
                                    ],
                                    type: 'com.bayer.tender.ccma.model.datatypes.PercentageType'
                                }"
                                enabled="false"
                                visible="{= %{ConditionType} === 'DescuentoComercial' || %{ConditionType} === 'DescuentoEspecial'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RoyalDecree}"
                        visible="{= %{RoyalDecree} === 'Yes' &amp;&amp; !['Rental','PVL'].includes(%{ConditionType})}"
                    >
                        <form:fields>
                            <m:Input
                                value="{
                                    parts: [
                                        { path: 'YD06' },
                                        { value: '3' },
                                        { value: '3' }
                                    ],
                                    type: 'com.bayer.tender.ccma.model.datatypes.PercentageType'
                                }"
                                enabled="false"
                                visible="{= %{RoyalDecree} === 'Yes' &amp;&amp; !['Rental','PVL'].includes(%{ConditionType})}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.royalDecreeIncl}"
                        visible="{= %{ConditionType} === 'PrecioNeto' &amp;&amp; %{YD06} > 0}"
                    >
                        <form:fields>
                            <m:CheckBox
                                enabled="false"
                                selected="{RoyalDecreeIncl}"
                                visible="{= %{ConditionType} === 'PrecioNeto' &amp;&amp; %{YD06} > 0}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RoyalDecreeApplies}"
                        visible="{= %{RoyalDecree} === 'Yes' &amp;&amp; !['Rental','DescuentoEspecial','PVL'].includes(%{ConditionType})}"
                    >
                        <form:fields>
                            <m:Select
                                selectedKey="{= %{RoyalDecree} ? %{RoyalDecree} : 'No'}"
                                enabled="false"
                                visible="{= %{RoyalDecree} === 'Yes' &amp;&amp; !['Rental','DescuentoEspecial','PVL'].includes(%{ConditionType})}"
                            >
                                <m:items>
                                    <core:Item
                                        key="No"
                                        text="No"
                                    />
                                    <core:Item
                                        key="Yes"
                                        text="Yes"
                                    />
                                </m:items>
                            </m:Select>
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceBeforeRC}"
                        visible="{= %{ConditionType} === 'PrecioNeto'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['YP10', 'Currency'], 
                                        type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{ConditionType} === 'PrecioNeto'}"
                                fieldGroupIds="priceInputPrecioNeto"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceBeforeRC}"
                        visible="{= %{ConditionType} === 'DescuentoComercial'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['NetPriceWithoutTax', 'Currency'], 
                                        type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{ConditionType} === 'DescuentoComercial'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RoyalDecreeValue}"
                        visible="{= %{RoyalDecree} === 'Yes' &amp;&amp; Number(%{RoyalDecreeValue}) > 0 &amp;&amp; !['Rental','DescuentoEspecial','PVL'].includes(%{ConditionType})}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['RoyalDecreeValue', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{RoyalDecree} === 'Yes' &amp;&amp; Number(%{RoyalDecreeValue}) > 0 &amp;&amp; !['Rental','DescuentoEspecial','PVL'].includes(%{ConditionType})}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceAfterRC}"
                        visible="{= %{RoyalDecree} === 'Yes' &amp;&amp; %{ConditionType} === 'PrecioNeto'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['NetPriceWithoutTaxAfterDeductionRD', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{RoyalDecree} === 'Yes' &amp;&amp; %{ConditionType} === 'PrecioNeto'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.MaximumPrice}"
                        visible="{= %{ConditionType} === 'PrecioNeto' &amp;&amp; %{ContractType} === 'Tender' }"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['MaximumPrice', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{ConditionType} === 'PrecioNeto' &amp;&amp; %{ContractType} === 'Tender' }"
                                fieldGroupIds="priceInputPrecioNeto"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.Tax}"
                        visible="{= %{ConditionType} !== 'Rental' || %{ConditionType} !== 'PVL'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ path: 'Tax', 
type: 'com.bayer.tender.ccma.model.datatypes.PercentageType'}"
                                enabled="false"
                                visible="{= %{ConditionType} !== 'Rental' || %{ConditionType} !== 'PVL'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceWtax}"
                        visible="{= %{ConditionType} !== 'Rental' || %{ConditionType} !== 'PVL'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['NetPriceWithTax', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{ConditionType} !== 'Rental' || %{ConditionType} !== 'PVL'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceWtaxAfterRC}"
                        visible="false"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['NetPriceWithTaxAfterDeductionRD', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="false"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RequestedVolume}"
                        visible="{= %{ConditionType} === 'Rental'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['RequestedVolume', 'CountryCode'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomNumberType'}"
                                enabled="false"
                                visible="{= %{ConditionType} === 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RentalPrice}"
                        visible="{= %{ConditionType} === 'Rental'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['RentalPrice', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{ConditionType} === 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.MonthlyRentPerUnit}"
                        visible="{= %{ConditionType} === 'Rental'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['MonthlyRentPerUnit', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{ConditionType} === 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.AnnualValue}"
                        visible="{= %{ConditionType} === 'Rental'}"
                    >
                        <form:fields>
                            <m:Input
                                value="{ parts: ['AnnualValue', 'Currency'], 
type: 'com.bayer.tender.ccma.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= %{ConditionType} === 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                </form:formElements>
            </form:FormContainer>
        </form:formContainers>
    </form:Form>
</core:FragmentDefinition>
