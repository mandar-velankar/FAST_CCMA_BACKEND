<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="idTerminateContractDialog"
        title="Terminate Contract"
        type="Message"
        state="Warning">
        
        <content>
            <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop sapUiSmallMarginBottom" renderType="Bare">
                <Label
                    text="Cancellation Note" />
                <TextArea
                    id="cancellationNote"
                    width="100%"
                    placeholder="Add note" />
                <Label
                    text="End Date"
                    design="Bold" />
                <DatePicker
                    id="terminationEndDate"
                    width="100%"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="short" />
            </VBox>
        </content>

        <beginButton>
            <Button
                type="Emphasized"
                text="Confirm"
                press=".onConfirmTermination" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelTermination" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>