<mvc:View
    controllerName="com.bayer.tender.ccma.controller.Master"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tree="sap.ui.table"
>
    <f:DynamicPage
        id="masterPage"
        preserveHeaderStateOnScroll="true"
        toggleHeaderOnTitleClick="false"
    >
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>title}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>
                <OverflowToolbar class="sapFDynamicPageAlignContent">
                    <Label
                        text="Country"
                        labelFor="idSlctCountry"
                    />
                    <Select id="idSlctCountry">
                        <core:Item
                            key="ES"
                            text="Spain"
                        />
                    </Select>
                    <Label
                        text="Brand"
                        labelFor="idSlctBrand"
                    />
                    <Select id="idSlctBrand">
                        <core:Item
                            key=""
                            text=""
                        />
                    </Select>
                    <Label
                        text="Product"
                        labelFor="idSelectProduct"
                    />
                    <Select id="idSelectProduct">
                        <core:Item
                            key=""
                            text=""
                        />
                    </Select>

                    <ToolbarSpacer />
                    <SearchField
                        id="idSearch"
                        search=".setFilter"
                        width="17.5rem"
                    />
                </OverflowToolbar>
                <Table
                    id="idContractsMasterTable"
                    inset="false"
                    items="{
							path: '/FastConditionContractsView',
							sorter: {
								path: 'ID',
								descending: false
							}
                    }"
                    class="sapFDynamicPageAlignContent"
                    width="auto"
                    updateFinished=".onUpdateFinished"
                    alternateRowColors="true"
                    contextualWidth="Auto"
                    growing="true"
                    growingThreshold="15"
                    growingScrollToLoad="false"
                >
                    <columns>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>OfferID}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>Owner}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier
                                    title="{i18n>Classification}" titleActive="true" titlePress="onClick"
                                />
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>Reference}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>Division}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>CustomerCode}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>Institute}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier
                                    title="{i18n>effectiveDate}" titleActive="true" titlePress="onClick"
                                />
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>expiryDate}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onListItemPress"
                            id="items"
                        >
                            <cells>
                                <Text text="{OfferID}" />
                                <Text text="{Owner}" />
                                <Text text="{Classification}" />
                                <Text text="{Reference}" />
                                <Text text="{Division}" />
                                <Text text="{CustomerCode}" />   
                                <Text text="{InstituteName}" />
                                <Text text="{
										path: 'ContractStartDate',
										type: 'sap.ui.model.odata.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
                                <Text text="{
										path: 'ContractEndDate',
										type: 'sap.ui.model.odata.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
