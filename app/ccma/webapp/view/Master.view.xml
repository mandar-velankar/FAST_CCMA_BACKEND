<mvc:View
	controllerName="com.bayer.tender.ccma.controller.Master"
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tree="sap.ui.table">

	<f:DynamicPage
		id="masterPage"
		preserveHeaderStateOnScroll="true"
		toggleHeaderOnTitleClick="false">
		
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text ="{i18n>title}"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>


		<f:content>
			<VBox>
				<OverflowToolbar class="sapFDynamicPageAlignContent">
					<Label
						text="Country"
						labelFor="idSlctCountry"
					/>
					<Select 
						id="idSlctCountry" 
					>
						<core:Item key="" text=""/>
					</Select>
					<Label
						text="Brand"
						labelFor="idSlctBrand"
					/>
					<Select 
						id="idSlctBrand" 
					>
						<core:Item key="" text=""/>
					</Select>
					<Label
						text="Product"
						labelFor="idSelectProduct"
					/>
					<Select 
						id="idSelectProduct"
					>
						<core:Item key="" text=""/>
					</Select>

					<ToolbarSpacer/>
					<SearchField id="idSearch" search=".setFilter" width="17.5rem"/>
				</OverflowToolbar>
                <tree:Table 
                    id="idContractsMasterTable"
                    rows="{
                        path: 'FastConditionContracts'
                    }"
                    selectionMode="Single"
                    rowActionCount="1"
                    rowSelectionChange=".onHandleSelectionChange"
                >
                    <tree:rowActionTemplate> 
                        <tree:RowAction> 
                            <tree:RowActionItem type="Navigation" press=".onListItemPress" /> 
                        </tree:RowAction> 
                    </tree:rowActionTemplate>
                    <tree:columns>
                        <tree:Column sortProperty="ID" filterProperty="ID">
                            <Label text="{i18n>id}" />
                            <tree:template>
                                <Text text="{OfferID}" />
                            </tree:template>
                        </tree:Column>
                        <tree:Column sortProperty="Owner" filterProperty="Owner">
                            <Label text="{i18n>owner}" />
                            <tree:template>
                                <Text text="{Owner}"/>
                            </tree:template>
                        </tree:Column>
                        <tree:Column sortProperty="Classification" filterProperty="Classification">
                            <Label text="{i18n>classification}" />
                            <tree:template>
                                <Text text="{Classification}"/>
                            </tree:template>
                        </tree:Column>
                        <tree:Column sortProperty="Reference" filterProperty="Reference">
                            <Label text="{i18n>reference}" />
                            <tree:template>
                                <Text text="{Reference}"/>
                            </tree:template>
                        </tree:Column>
                        <tree:Column sortProperty="Division" filterProperty="Division">
                            <Label text="{i18n>division}" />
                            <tree:template>
                                <Text text="{Division}"/>
                            </tree:template>
                        </tree:Column>
                        <tree:Column sortProperty="CustomerCode" filterProperty="CustomerCode">
                            <Label text="{i18n>customerCode}" />
                            <tree:template>
                                <Text text="{CustomerCode}"/>
                            </tree:template>
                        </tree:Column>
                        <tree:Column sortProperty="Institute" filterProperty="Institute">
                            <Label text="{i18n>institute}" />
                            <tree:template>
                                <Text text="{InstituteName}"/>
                            </tree:template>
                        </tree:Column>
                        <tree:Column sortProperty="EffectiveDate" filterProperty="EffectiveDate">
                            <Label text="{i18n>effectiveDate}" />
                            <tree:template>
                                <Text text="{ContractStartDate}"/>
                            </tree:template>
                        </tree:Column>
                        <tree:Column sortProperty="ExpiryDate" filterProperty="ExpiryDate">
                            <Label text="{i18n>expiryDate}" />
                            <tree:template>
                                <Text text="{ContractEndDate}"/>
                            </tree:template>
                        </tree:Column>
                        <tree:Column sortProperty="Status" filterProperty="Status">
                            <Label text="{i18n>status}" />
                            <tree:template>
                                <Text text="{Status}"/>
                            </tree:template>
                        </tree:Column>
                    </tree:columns>
                </tree:Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>