<mvc:View
    controllerName="com.bayer.tender.ccma.controller.Master"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tree="sap.ui.table"
>
    <f:DynamicPage
        id="masterPage"
        preserveHeaderStateOnScroll="true"
        toggleHeaderOnTitleClick="false"
    >
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>title}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>
                <OverflowToolbar class="sapFDynamicPageAlignContent">
                    <Label
                        text="Country"
                        labelFor="idSlctCountry"
                    />
                    <Select id="idSlctCountry" change=".setFilter">
                        <core:Item
                            key="ES"
                            text="Spain"
                        />
                    </Select>
                    <Label
                        text="Brand"
                        labelFor="idSlctBrand"
                    />
                    <Select id="idSlctBrand" change=".setFilter">
                        <core:Item
                            key="All_Brands"
                            text="All"
                        />
                        <core:Item
                            key="0810A10050"
                            text="Ciprofloxacin"
                        />
                         <core:Item
                            key="6573550D46"
                            text="Gadovist"
                        />
                        <core:Item
                            key="0871D20A02"
                            text="Mirena"
                        />
                    </Select>
                    <Label
                        text="Product"
                        labelFor="idSelectProduct"
                    />
                    <Select id="idSelectProduct" change=".setFilter">
                        <core:Item
                            key="All_Products"
                            text="All"
                        />
                        <core:Item
                            key="204235"
                            text="GADOVIST 1.0 SOLU VIAL 1X30ML IT MS NRR"
                        />
                        <core:Item
                            key="205423"
                            text="MIRENA 1x1 EVO ES"
                        />
                    </Select>

                    <ToolbarSpacer />
                    <SearchField
                        id="idSearch"
                        search=".setFilter"
                        width="17.5rem"
                    />
                </OverflowToolbar>
                <Table
                    id="idContractsMasterTable"
                    inset="false"
                    items="{
							path: '/FastConditionContractsView',
							sorter: {
								path: 'createdAt',
								descending: true
							}
                    }"
                    class="sapFDynamicPageAlignContent"
                    width="auto"
                    updateFinished=".onUpdateFinished"
                    alternateRowColors="true"
                    contextualWidth="Auto"
                    growing="true"
                    growingThreshold="15"
                    growingScrollToLoad="false"
                >
                    <columns>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>id}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>owner}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier
                                    title="{i18n>classification}" titleActive="true" titlePress="onClick"
                                />
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>reference}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>division}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>customerCode}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>institute}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier
                                    title="{i18n>effectiveDate}" titleActive="true" titlePress="onClick"
                                />
                            </header>
                        </Column>
                        <Column>
                            <header>
                                <ObjectIdentifier title="{i18n>expiryDate}" titleActive="true" titlePress="onClick"/>
                            </header>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onListItemPress"
                            id="items"
                        >
                            <cells>
                                <Text text="{OfferID}" />
                                <Text text="{Owner}" />
                                <Text text="{ContractType}" />
                                <Text text="{Reference}" />
                                <Text text="{Division}" />
                                <Text text="{CustomerID}" />   
                                <Text text="{InstituteName}" />
                                <Text text="{
										path: 'ContractStartDate',
										type: 'sap.ui.model.odata.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
                                <Text text="{
										path: 'ContractEndDate',
										type: 'sap.ui.model.odata.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
