{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.bayer.tender.ccma",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.17.0",
      "toolsId": "9fae0d54-5190-4322-aede-1a8d9e9a4d5c"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/condition-contract/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "accessService": {
        "uri": "/v2/access/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.134.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "resourceRoots": {
      "com.bayer.tender.uilib": "./libraries/uilib/src/com/bayer/tender/uilib"
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.bayer.tender.ccma.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "synchronizationMode": "None"
        }
      },
      "access": {
        "dataSource": "accessService",
        "preload": true
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.bayer.tender.ccma.view",
        "async": true,
        "viewPath": "com.bayer.tender.ccma.view",
        "controlAggregation": "beginColumnPages",
        "controlId": "layout",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "pattern": "",
          "name": "master",
          "target": "master"
        },
        {
          "name": "detail",
          "pattern": "detail/{id}/{layout}",
          "target": [
            "master",
            "detail"
          ]
        },
        {
          "name": "detail-detail",
          "pattern": "detail/{id}/detail-detail/{productPackId}/{layout}",
          "target": [
            "master",
            "detail",
            "detailDetail"
          ]
        }
      ],
      "targets": {
        "master": {
          "viewName": "Master",
          "viewLevel": 1,
          "viewId": "master"
        },
        "detail": {
          "viewName": "Detail",
          "viewId": "detail",
          "viewLevel": 1,
          "controlAggregation": "midColumnPages"
        },
        "detailDetail": {
          "viewName": "DetailDetail",
          "viewId": "detailDetail",
          "viewLevel": 1,
          "controlAggregation": "endColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "com.bayer.tender.ccma.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}