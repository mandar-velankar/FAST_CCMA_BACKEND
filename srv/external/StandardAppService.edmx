          <Parameter Name="productCode" Type="Edm.Int32" Mode="In" Nullable="true"/>
          <Parameter Name="instituteID" Type="Edm.Int32" Mode="In" Nullable="true"/>
          <Parameter Name="customerID" Type="Edm.String" Mode="In" Nullable="true"/>
          <Parameter Name="materialNumber" Type="Edm.String" Mode="In" Nullable="true"/>
          <Parameter Name="countryCode" Type="Edm.String" Mode="In" Nullable="true"/>
        </FunctionImport>
        <FunctionImport Name="updateFinalContractStartEndDate" ReturnType="Edm.String" m:HttpMethod="POST">
          <Parameter Name="OfferID" Type="Edm.String" Mode="In" Nullable="true"/>
          <Parameter Name="ContractStartDate" Type="Edm.DateTime" Mode="In" sap:display-format="Date" Nullable="true"/>
          <Parameter Name="ContractEndDate" Type="Edm.DateTime" Mode="In" sap:display-format="Date" Nullable="true"/>
        </FunctionImport>
        <FunctionImport Name="createAllFastConditionContracts" ReturnType="Edm.String" m:HttpMethod="POST">
